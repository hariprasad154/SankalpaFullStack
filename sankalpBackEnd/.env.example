# Master env — copy to .env at repo root

# FRONTEND
VITE_BACKEND_BASE_URL_SANKALPA=http://localhost:8000
VITE_APP_NAME=Sankalpa
VITE_POLL_INTERVAL_MS=5000

# BACKEND
BACKEND_BASE_URL_SANKALPA=http://localhost:8000
FRONTEND_URL_SANKALPA=http://localhost:5173
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzACY8RavP687Z6xcXKSklM57YD2N_48Hqj-KSughYp6R1XN2iyesI8ABALF2vNEyAa/exec

JWT_SECRET=sankalpa-secret
AUTO_APPLY_INTERVAL_HOURS=6
MAX_APPLY_PER_RUN=50
