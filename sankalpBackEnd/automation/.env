# Copy to .env and fill in secrets (automation/.env is gitignored).

KEYWORDS=java spring backend
INTERVAL_SECONDS=10
AUTOMATION_MODE=ingest

NAUKRI_URL=https://www.naukri.com
NAUKRI_EMAIL=hariprasadnaidugujjini@gmail.com
NAUKRI_PASSWORD=
NAUKRI_HOLD_SECONDS=60
NAUKRI_LOGIN_WAIT=20

NAUKRI_FLOW_TABS=Applies,Top Candidate,Preferences,You might like
NAUKRI_HOME_URL=https://www.naukri.com/mnjuser/homepage
NAUKRI_RECOMMENDED_URL=https://www.naukri.com/mnjuser/recommendedjobs
FLOW_MAX_JOBS=1000

# --- Batch apply: python main.py batch ---
BATCH_APPLY_SIZE=5
NAUKRI_BATCH_PAGE_TIMEOUT=30
NAUKRI_APPLY_BUTTON_WAIT=35
# Stop after this many successful applies (0 = no limit)
NAUKRI_MAX_APPLY_JOBS=0

# Dedupe: skip toggles whose card text is already in jobs.json (description contains match)
NAUKRI_DEDUPE_MIN_CHARS=30
# When tuple XPath misses: treat loose checkbox as job only if card text is at least this long (filters nav chrome)
NAUKRI_TOGGLE_CARD_MIN_CHARS=45
NAUKRI_JOB_DESC_MAX_CHARS=2500
# Batch apply tab order: NAUKRI_BATCH_TABS, or if unset NAUKRI_FLOW_TABS (same comma list)
NAUKRI_BATCH_TABS=Applies,Profile,Top Candidate,Preferences,You might like
# Per-tab batch loop: stop after this many applies on one tab, then next tab (avoids infinite Applies)
NAUKRI_MAX_BATCHES_PER_TAB=60
# No new jobs after this many scroll retries on one tab → next tab
NAUKRI_EMPTY_PICK_TAB_ROUNDS=3
# Dedupe scope: per_tab = same job can be picked on Profile if only recorded under Applies; global = one job once for all tabs
NAUKRI_DEDUPE_SCOPE=per_tab
# After this many Apply-button timeouts or uncleared modals in a row, skip to the next feed tab
NAUKRI_APPLY_CLICK_FAIL_TAB_BREAK=2
NAUKRI_MODAL_FAIL_TAB_BREAK=2
# Apply screening popup: email (defaults to NAUKRI_EMAIL if empty), phone, DD/MM style date
NAUKRI_POPUP_EMAIL=hariprasadnaidugujjini@gmail.com
NAUKRI_POPUP_PHONE=9866817159
NAUKRI_POPUP_DATE_DDMM=23/07
NAUKRI_CHECKBOX_CSS=i.naukicon-ot-checkbox,i[class*='naukicon-ot-checkbox'],i[class*='ot-checkbox']
# No Qa match + 2+ modal checkboxes: pick one at random and append blob to data/missed_questions.json (0=off)
NAUKRI_RANDOM_UNKNOWN_CHECKBOX=1

# Apply popup (best-effort; adjust if Naukri changes labels). Qa.txt keyword routing uses these.
NAUKRI_APPLY_YEARS=3
NAUKRI_EXPECTED_SALARY=1400000
NAUKRI_CURRENT_SALARY=807000
NAUKRI_NOTICE=15 days
# Chat popup: LWD / notice wording — reply typed into "Type message here" when matched
NAUKRI_LWD_REPLY=15 days
NAUKRI_SKILLS_REPLY=Java, Spring Boot, Microservices
# If no keyword rule matches, this is used before NAUKRI_FALLBACK_REPLIES
NAUKRI_GENERIC_POPUP_REPLY=Yes
NAUKRI_FALLBACK_REPLIES=Yes,0,N/A
# Apply-popup radios: try these label/value matches in order (first hit per group), then generic reply
NAUKRI_RADIO_DEFAULT_ORDER=Yes,YES,yes,y,Y
NAUKRI_MODAL_MAX_ROUNDS=6
NAUKRI_MODAL_MAX_SECONDS=45
# Save disabled until input events: retry nudge (click field + space) this many times
NAUKRI_SAVE_NUDGE_ATTEMPTS=6
# Optional Qa overrides (see naukri_batch_apply._build_qa_rules)
# NAUKRI_QA_FIXED_CTC=750000
# NAUKRI_QA_VARIABLE_CTC=50000
# NAUKRI_QA_OFFER_CTC=1250000
# NAUKRI_QA_SECONDARY_SKILL_YEARS=2.5 to 3
# NAUKRI_QA_PROFICIENCY=8
# NAUKRI_QA_DOMAIN=Yes
# NAUKRI_QA_CURRENT_CITY=Chennai
# NAUKRI_QA_GRAD_YEAR=2022
# NAUKRI_QA_CGPA=8.5
# NAUKRI_QA_JOB_CHANGE=...
# NAUKRI_QA_WHY_JOIN=...
# NAUKRI_QA_PROJECT=...
# NAUKRI_QA_CERTS=AWS Certified Developer
